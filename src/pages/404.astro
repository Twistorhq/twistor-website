---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/webp" href={base + "/logo-mark.webp"} />
    <title>404: Off the map | Twistor</title>
    <meta name="description" content="This page does not exist. Stretch your legs with a quick game, then head back." />
    <meta name="robots" content="noindex, nofollow" />
    <style>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; background: #ffffff; color: #0f172a; }
      .wrap { width: min(880px, calc(100% - 48px)); margin: 0 auto; padding: 28px 0 64px; }
      .masthead { display: flex; align-items: center; justify-content: space-between; padding-bottom: 20px; border-bottom: 1px solid #e2e8f0; }
      .wordmark { font-weight: 800; font-size: 22px; letter-spacing: -1px; text-decoration: none; color: #0f172a; }
      .wordmark span { color: #4f46e5; }
      .home-link { font-size: 13px; font-weight: 700; color: #4f46e5; text-decoration: none; padding: 12px 4px; }
      .home-link:focus-visible { outline: 3px solid #4f46e5; outline-offset: 3px; }
      .code { font: 800 clamp(72px, 14vw, 128px)/1 ui-monospace, Menlo, monospace; letter-spacing: -6px; margin: 44px 0 8px; color: #0f172a; }
      .code span { color: #4f46e5; }
      h1 { font-size: clamp(24px, 4vw, 34px); letter-spacing: -1px; margin: 0 0 10px; }
      .lede { font-size: 16px; line-height: 1.6; color: #64748b; max-width: 560px; margin: 0 0 26px; }
      .actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 26px; }
      .btn { display: inline-flex; align-items: center; min-height: 48px; padding: 14px 22px; border-radius: 8px; font-size: 14px; font-weight: 700; text-decoration: none; }
      .btn-primary { background: #4f46e5; color: #fff; }
      .btn-primary:focus-visible { outline: 3px solid #4f46e5; outline-offset: 3px; }
      .btn-ghost { border: 1px solid #e2e8f0; color: #0f172a; }
      .btn-ghost:focus-visible { outline: 3px solid #4f46e5; outline-offset: 3px; }
      .foot { margin-top: 40px; font-size: 12px; color: #64748b; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="masthead">
        <a class="wordmark" href={base + "/"} aria-label="Twistor home">twistor<span>.</span></a>
        <a class="home-link" href={base + "/"}>Back home</a>
      </header>
      <main>
        <p class="code" aria-hidden="true">4<span>0</span>4</p>
        <h1>Off the map.</h1>
        <p class="lede">This page took a wrong turn. While you are here, a random arcade game loads below. Hit shuffle for another one.</p>
        <div id="game"></div>
        <div style="margin-top:12px"><button type="button" id="shuffle" class="btn btn-ghost">Another game</button></div>
        <div class="actions">
          <a class="btn btn-primary" href={base + "/"}>Back home</a>
          <a class="btn btn-ghost" href={base + "/products/trades-front-office/"}>See what we build</a>
        </div>
        <p class="foot">Prepared by Twistor Holdings LLC</p>
      </main>
    </div>
    <script type="module" data-base={base}>
      const base = document.currentScript.dataset.base || '';
      const el = document.getElementById('game');
      const shuffleBtn = document.getElementById('shuffle');
      let current = null;
      let currentIdx = -1;

      // Corporate 404: the four Easter egg games. Car and snake carry their
      // own corporate theme; hoops takes page-matched colors; the runner is
      // the trades-theme boot jumper.
      const GAMES = [
        { file: '/games/tw-553-car.js', mount: m => m.mountCar(el, { theme: 'corporate' }) },
        { file: '/games/tw-553-snake.js', mount: m => m.mountSnake(el, { theme: 'corporate' }) },
        { file: '/games/tw-553-hoops.js', mount: m => m.mountHoops(el, {}) },
        { file: '/games/tw-553-runner.js', mount: m => m.mountRunner(el, { theme: 'trades' }) },
      ];

      async function load(idx) {
        if (current) { try { current.destroy(); } catch (e) {} current = null; }
        el.innerHTML = '';
        currentIdx = idx;
        try {
          const m = await import(base + GAMES[idx].file);
          if (currentIdx !== idx) return;
          current = GAMES[idx].mount(m);
        } catch (err) {
          el.innerHTML = '<p style="color:#64748b;font-size:14px">The game could not load, but the way home still works.</p>';
        }
      }

      function roll() {
        let i = Math.floor(Math.random() * GAMES.length);
        while (GAMES.length > 1 && i === currentIdx) i = Math.floor(Math.random() * GAMES.length);
        load(i);
      }

      shuffleBtn.addEventListener('click', roll);
      roll();
    </script>
  </body>
</html>

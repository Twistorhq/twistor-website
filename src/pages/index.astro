---
import '@fontsource/bricolage-grotesque/500.css';
import '@fontsource/bricolage-grotesque/700.css';

const featured = {
  slug: 'trades-front-office',
  name: 'Trades AI Front Office',
  tagline: 'Every call answered. Every urgent job triaged.',
  blurb:
    'For HVAC, plumbing, roofing, and electrical shops: AI reception that answers every call, triages urgency, and posts jobs straight to your dispatch board. Built for the trades first, because missed calls are missed revenue.',
};
const products = [
  {
    slug: 'dental-front-office',
    name: 'Dental AI Front Office',
    tagline: 'Never lose a patient to voicemail again.',
    blurb:
      'AI answers every call, confirms appointments, texts back missed calls in under a minute, and books directly inside your practice management software, with a monthly report showing recovered revenue.',
  },
  {
    slug: 'dispatch-os',
    name: 'Dispatch OS',
    tagline: 'One board that runs your phones and your schedule.',
    blurb:
      'Jobs arrive by phone, email, or web. AI answers, triages, schedules, and confirms, while you watch a single dispatch board.',
  },
  {
    slug: 'compliance-agent',
    name: 'Compliance Evidence Agent',
    tagline: 'Your audit evidence, collected continuously.',
    blurb:
      'An agent living in your repos and cloud accounts, continuously collecting SOC 2 and HIPAA evidence and opening PRs when something drifts.',
  },
  {
    slug: 'data-analytics',
    name: 'Managed Data + Analytics',
    tagline: 'Your data team, done for you.',
    blurb:
      'Pipelines from your SaaS tools into a clean warehouse, dashboards you actually read, and a monthly KPI memo in plain English.',
  },
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/webp" href={base + "/logo-mark.webp"} />
    <link rel="stylesheet" href={base + "/vendor/leaflet/leaflet.css"} />
    <meta property="og:image" content="https://twistor.co/logo-mark.webp" />
    <meta property="og:title" content="Twistor | The company that does it all" />
    <meta
      property="og:description"
      content="Twistor builds AI systems that answer your phones, recover your revenue, and run your operations. One platform, every product."
    />
    <meta property="og:url" content="https://twistor.co/" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Twistor | The company that does it all" />
    <meta
      name="twitter:description"
      content="Twistor builds AI systems that answer your phones, recover your revenue, and run your operations. One platform, every product."
    />
    <title>Twistor | The company that does it all</title>
    <meta
      name="description"
      content="Twistor builds AI systems that answer your phones, recover your revenue, and run your operations. One platform, every product."
    />
    <style>
      :root {
        --bg: #FAF7F2;
        --surface: #FFFFFF;
        --ink: #1C1A17;
        --muted: #5F5A54;
        --accent: #FF5A1F;
        --accent-text: #B5430E;
        --line: #E5DFD5;
      }
      * { box-sizing: border-box; }
      body {
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        margin: 0;
        color: var(--ink);
        background: var(--bg);
        line-height: 1.6;
        font-size: 1rem;
      }
      h1, h2, h3 { font-family: 'Bricolage Grotesque', system-ui, sans-serif; }
      header, main, footer { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 24px;
        padding-bottom: 24px;
      }
      .logo { font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-weight: 700; font-size: 1.25rem; letter-spacing: -0.02em; }
      .logo span { color: var(--accent); }
      nav a { margin-left: 20px; color: var(--muted); text-decoration: none; font-weight: 500; }
      nav a:hover { color: var(--ink); }
      .hero { padding: 88px 0 64px; }
      .hero h1 { font-size: 3rem; line-height: 1.08; letter-spacing: -0.03em; margin: 0 0 16px; font-weight: 700; }
      .hero h1 span { color: var(--accent-text); }
      .hero p { font-size: 1.2rem; color: var(--muted); max-width: 640px; }
      .cta-row { margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap; }
      .btn { display: inline-block; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 1rem; }
      .btn-primary { background: var(--accent); color: #1C1A17; }
      .btn-ghost { border: 1px solid var(--line); color: var(--ink); }
      .section-title { font-size: 2rem; letter-spacing: -0.02em; margin: 0 0 8px; font-weight: 700; }
      .section-sub { color: var(--muted); margin: 0 0 32px; max-width: 640px; font-size: 1rem; }
      .featured {
        border: 1px solid var(--line);

        border-radius: 12px;
        padding: 32px;
        background: var(--surface);
        margin-bottom: 20px;
      }
      .featured h3 { margin: 0 0 4px; font-size: 1.6rem; font-weight: 700; }
      .featured .tagline { color: var(--accent-text); font-weight: 600; font-size: 1rem; margin: 0 0 12px; }
      .featured p { color: var(--muted); font-size: 1rem; margin: 0 0 16px; max-width: 720px; }
      .featured a { color: var(--accent-text); font-weight: 600; text-decoration: none; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; padding: 0 0 72px; }
      .card { border: 1px solid var(--line); border-radius: 12px; padding: 24px; background: var(--surface); }
      .card h3 { margin: 0 0 4px; font-size: 1.15rem; font-weight: 700; }
      .card .tagline { color: var(--accent-text); font-weight: 600; font-size: 1rem; margin: 0 0 8px; }
      .card p { color: var(--muted); font-size: 1rem; margin: 0 0 12px; }
      .card a { color: var(--accent-text); font-weight: 600; text-decoration: none; }
      .platform { background: var(--surface); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 64px 0; margin-top: 24px; }
      .platform .inner { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
      .platform h2 { font-size: 2rem; margin: 0 0 12px; letter-spacing: -0.02em; font-weight: 700; }
      .platform p { color: var(--muted); max-width: 680px; font-size: 1rem; }
      .platform ul { color: var(--muted); columns: 2; max-width: 680px; padding-left: 20px; font-size: 1rem; }
      .platform li { margin-bottom: 8px; }
      .platform li::marker { color: var(--accent); }
      #contact { padding: 64px 0; }
      .contact-card {
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--surface);
        padding: 32px;
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        align-items: center;
        justify-content: space-between;
      }
      .contact-card h3 { margin: 0 0 8px; font-size: 1.4rem; font-weight: 700; }
      .contact-card p { color: var(--muted); margin: 0; max-width: 560px; font-size: 1rem; }
      .leak { padding: 72px 0 24px; }
      .leak-card {
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--surface);
        padding: 32px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        margin-bottom: 48px;
      }
      .field { margin-bottom: 28px; }
      .field:last-child { margin-bottom: 0; }
      .field label { display: block; font-weight: 600; font-size: 1rem; margin-bottom: 4px; }
      .field .hint { display: block; color: var(--muted); font-size: 0.9rem; margin-bottom: 10px; }
      .field-row { display: flex; align-items: center; gap: 16px; }
      .field-row output { min-width: 76px; text-align: right; font-weight: 700; font-size: 1.1rem; font-family: 'Bricolage Grotesque', system-ui, sans-serif; }
      input[type="range"] {
        -webkit-appearance: none;
        appearance: none;
        width: 100%;
        height: 6px;
        border-radius: 3px;
        background: var(--line);
        margin: 0;
      }
      input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: var(--accent);
        border: 3px solid var(--surface);
        box-shadow: 0 1px 4px rgba(28, 26, 23, 0.3);
        cursor: pointer;
      }
      input[type="range"]::-moz-range-thumb {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: var(--accent);
        border: 3px solid var(--surface);
        box-shadow: 0 1px 4px rgba(28, 26, 23, 0.3);
        cursor: pointer;
      }
      input[type="range"]:focus-visible { outline: 3px solid var(--accent-text); outline-offset: 4px; }
      .leak-results { border-left: 1px solid var(--line); padding-left: 40px; }
      .leak-kicker { color: var(--accent-text); font-weight: 700; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px; }
      .leak-amount { font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-weight: 700; letter-spacing: -0.02em; margin: 0; }
      .leak-figure-month .leak-amount { font-size: 3rem; color: var(--ink); }
      .leak-figure-year .leak-amount { font-size: 1.75rem; color: var(--muted); }
      .leak-results .per { color: var(--muted); font-size: 1rem; margin-left: 8px; }
      .leak-results .btn { margin: 20px 0 8px; }
      .leak-math { margin-top: 16px; border-top: 1px solid var(--line); padding-top: 16px; }
      .leak-math summary { cursor: pointer; font-weight: 600; color: var(--accent-text); }
      .leak-math p { font-size: 0.95rem; color: var(--muted); }
      .leak-math .equation { font-family: ui-monospace, SFMono-Regular, monospace; background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; color: var(--ink); font-size: 0.95rem; }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
      .tradeview { background: var(--surface); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 64px 0; }
      .tradeview .inner { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
      .tradeview h2 { font-size: 2rem; margin: 0 0 12px; letter-spacing: -0.02em; font-weight: 700; }
      .tradeview .lede { color: var(--muted); max-width: 680px; font-size: 1rem; margin: 0 0 8px; }
      .sample-tag {
        display: inline-block; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
        color: var(--accent-text); border: 1px solid var(--accent-text); border-radius: 6px; padding: 4px 10px; margin: 0 0 20px;
      }
      .tv-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 24px; align-items: stretch; margin: 0 0 24px; }
      #tv-map { height: 380px; border: 1px solid var(--line); border-radius: 12px; background: #EDE8DF; z-index: 0; }
      .tv-map-fallback { display: none; border: 1px solid var(--line); border-radius: 12px; background: #EDE8DF; padding: 32px; color: var(--muted); text-align: center; }
      .tv-side { border: 1px solid var(--line); border-radius: 12px; padding: 24px; background: var(--bg); display: flex; flex-direction: column; }
      .tv-side h3 { margin: 0 0 4px; font-size: 1.1rem; font-weight: 700; }
      .tv-side .tv-sub { color: var(--muted); font-size: 0.9rem; margin: 0 0 16px; }
      .tv-row { display: flex; justify-content: space-between; align-items: baseline; padding: 10px 0; border-top: 1px solid var(--line); font-size: 0.95rem; }
      .tv-row .tv-label { color: var(--muted); }
      .tv-row .tv-val { font-weight: 700; font-family: 'Bricolage Grotesque', system-ui, sans-serif; }
      .tv-total { margin-top: auto; padding-top: 16px; }
      .tv-total .tv-amount { font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-weight: 700; font-size: 2.2rem; letter-spacing: -0.02em; color: var(--ink); }
      .tv-total .tv-per { color: var(--muted); font-size: 0.9rem; }
      .tv-cta-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
      .tv-note { color: var(--muted); font-size: 0.9rem; margin: 0; }
      .live-tag {
        display: inline-block; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
        color: #1C1A17; background: var(--accent); border-radius: 6px; padding: 4px 10px; margin: 0 0 20px;
      }
      .tv-toggles { display: flex; flex-wrap: wrap; gap: 16px; margin: 12px 0 4px; font-size: 0.9rem; }
      .tv-toggles label { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; color: var(--ink); }
      .tv-toggles input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--accent-text); cursor: pointer; }
      .tv-toggles input[type="checkbox"]:focus-visible { outline: 3px solid var(--accent-text); outline-offset: 2px; }
      .tv-legend { display: flex; flex-wrap: wrap; gap: 16px; margin: 8px 0 0; font-size: 0.85rem; color: var(--muted); }
      .tv-legend .tv-dot { display: inline-block; width: 12px; height: 12px; border-radius: 999px; margin-right: 6px; vertical-align: baseline; }
      .tv-attrib { font-size: 0.8rem; color: var(--muted); margin: 12px 0 0; }
      .tv-attrib a { color: var(--accent-text); }
      .tv-live-panel .tv-row .tv-val { font-family: system-ui, sans-serif; font-size: 0.9rem; }
      .tv-asof { display: block; font-size: 0.78rem; color: var(--muted); font-weight: 400; }
      :global(.tv-pin-wrap) { background: none; border: none; }
      :global(.tv-pin) {
        background: var(--tv-pin-bg, var(--accent)); color: var(--tv-pin-fg, #1C1A17); font-weight: 700; font-size: 0.75rem;
        border: 2px solid #FFFFFF; border-radius: 999px; padding: 3px 8px; white-space: nowrap;
        box-shadow: 0 1px 4px rgba(28, 26, 23, 0.35); font-family: system-ui, sans-serif;
      }
      .leaflet-container { font-family: system-ui, sans-serif; }
      @media (max-width: 720px) {
        .tv-grid { grid-template-columns: 1fr; }
        #tv-map { height: 280px; }
        .leak-card { grid-template-columns: 1fr; gap: 28px; }
        .leak-results { border-left: none; padding-left: 0; border-top: 1px solid var(--line); padding-top: 28px; }
      }
      a:focus-visible { outline: 3px solid var(--accent-text); outline-offset: 3px; border-radius: 4px; }
      .btn:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
      summary:focus-visible { outline: 3px solid var(--accent-text); outline-offset: 3px; border-radius: 4px; }
      footer { padding: 40px 24px; color: var(--muted); font-size: 0.9rem; border-top: 1px solid var(--line); }
      @media (max-width: 640px) {
        .hero h1 { font-size: 2.2rem; }
        .platform ul { columns: 1; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="logo">Twistor<span>.</span></div>
      <nav>
        <a href="#products">Products</a>
        <a href="#platform">Platform</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>The company that <span>does it all.</span></h1>
        <p>
          Twistor builds AI systems that answer your phones, recover your
          revenue, and run your operations. One platform, every product.
          Designed, deployed, and supported by the team that builds it.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#contact">Book a demo</a>
          <a class="btn btn-ghost" href="#products">See the products</a>
        </div>
      </section>

      <section class="leak" id="leak-calculator" aria-labelledby="leak-heading">
        <h2 class="section-title" id="leak-heading">How much revenue is walking out your door?</h2>
        <p class="section-sub">
          Every missed call is a job you almost won. Set the sliders to your
          shop's numbers and see what those calls cost you.
        </p>
        <div class="leak-card">
          <div class="leak-inputs">
            <div class="field">
              <label for="leak-calls">Missed calls per week</label>
              <span class="hint" id="leak-calls-hint">Calls that hit voicemail or rang out, 0 to 50.</span>
              <div class="field-row">
                <input type="range" id="leak-calls" min="0" max="50" step="1" value="8" aria-describedby="leak-calls-hint" />
                <output id="leak-calls-out" for="leak-calls">8</output>
              </div>
            </div>
            <div class="field">
              <label for="leak-value">Average job value</label>
              <span class="hint" id="leak-value-hint">What one won job is worth on average, $100 to $5,000.</span>
              <div class="field-row">
                <input type="range" id="leak-value" min="100" max="5000" step="50" value="850" aria-describedby="leak-value-hint" />
                <output id="leak-value-out" for="leak-value">$850</output>
              </div>
            </div>
            <div class="field">
              <label for="leak-rate">Close rate</label>
              <span class="hint" id="leak-rate-hint">Share of quoted jobs you normally win, 10% to 90%.</span>
              <div class="field-row">
                <input type="range" id="leak-rate" min="10" max="90" step="1" value="40" aria-describedby="leak-rate-hint" />
                <output id="leak-rate-out" for="leak-rate">40%</output>
              </div>
            </div>
          </div>
          <div class="leak-results">
            <p class="leak-kicker">Estimated revenue leaking</p>
            <p class="leak-figure-month"><span class="leak-amount" id="leak-month">$11,778</span><span class="per">/month</span></p>
            <p class="leak-figure-year"><span class="leak-amount" id="leak-year">$141,331</span><span class="per">/year</span></p>
            <a class="btn btn-primary" href={base + "/products/trades-front-office/"}>See what Twistor recovers</a>
            <details class="leak-math">
              <summary>How this number is calculated</summary>
              <p>
                <strong>The concept: expected lost revenue.</strong> Every
                missed call is demand that reached you and got nothing back.
                This prices the jobs you almost won.
              </p>
              <p class="equation">leak / month = missed calls / week × 4.33 × avg job value × close rate</p>
              <p>
                <strong>Why it works:</strong> your close rate says what share
                of those callers you would have won. The job value says what
                each was worth. 4.33 is the average number of weeks in a
                month. Multiply the three and the leak stops being a feeling
                and becomes a figure you can act on.
              </p>
            </details>
            <p class="sr-only" aria-live="polite" id="leak-live"></p>
          </div>
        </div>
      </section>

      <section id="products">
        <h2 class="section-title">Products</h2>
        <p class="section-sub">
          Five products, one platform. Our wedge is the trades, where a
          missed call is a missed job.
        </p>
        <div class="featured">
          <h3>{featured.name}</h3>
          <p class="tagline">{featured.tagline}</p>
          <p>{featured.blurb}</p>
          <a href={`/products/${featured.slug}/`}>Learn more →</a>
        </div>
        <div class="grid">
          {products.map((p) => (
            <div class="card">
              <h3>{p.name}</h3>
              <p class="tagline">{p.tagline}</p>
              <p>{p.blurb}</p>
              <a href={`/products/${p.slug}/`}>Learn more →</a>
            </div>
          ))}
        </div>
      </section>
    </main>

    <section class="tradeview" aria-labelledby="tv-heading">
      <div class="inner">
        <h2 id="tv-heading">Trade View: the shape of your leak map</h2>
        <p class="lede" id="tv-lede">
          Sample pins showing the shape of what Trade View watches for your
          shop, every morning. Live public signals connect here soon: your
          shop's private leak map is one click away.
        </p>
        <p><span class="sample-tag" id="tv-data-tag">Sample data: fictional shops</span></p>
        <div class="tv-grid">
          <div>
            <div id="tv-map" role="region" aria-label="Sample map of the Denver metro area with pins showing fictional missed-revenue amounts"></div>
            <p class="sr-only" aria-live="polite" id="tv-status"></p>
            <div class="tv-map-fallback" id="tv-map-fallback">
              The interactive map needs a network connection. The sample totals
              are listed here instead, and your shop's real map is one click away.
            </div>
            <div class="tv-toggles" role="group" aria-label="Map layers" id="tv-toggles" hidden>
              <label><input type="checkbox" id="tv-toggle-permits" checked> <span id="tv-toggle-permits-label">Building permits</span></label>
              <label><input type="checkbox" id="tv-toggle-weather" checked> <span id="tv-toggle-weather-label">Weather alerts</span></label>
            </div>
            <div class="tv-legend" id="tv-legend" hidden></div>
            <p class="tv-attrib" id="tv-attrib" hidden></p>
          </div>
          <div class="tv-side" id="tv-panel-sample">
            <h3>Sample leak ledger</h3>
            <p class="tv-sub">Fictional shops, Denver metro. Your numbers would be real.</p>
            <div class="tv-row"><span class="tv-label">Missed follow-ups</span><span class="tv-val">$7,050</span></div>
            <div class="tv-row"><span class="tv-label">Stale quotes</span><span class="tv-val">$9,500</span></div>
            <div class="tv-row"><span class="tv-label">At-risk customers</span><span class="tv-val">$7,400</span></div>
            <div class="tv-total">
              <div class="tv-amount">$23,950</div>
              <div class="tv-per">sitting still in this sample map</div>
            </div>
          </div>
          <div class="tv-side tv-live-panel" id="tv-panel-live" hidden>
            <h3>Live public signals</h3>
            <p class="tv-sub">Public data, Denver metro. Fetched live from public sources.</p>
            <div id="tv-live-rows"></div>
            <p class="tv-note" style="margin-top: auto; padding-top: 16px;">Your shop's private leak map (missed follow-ups, stale quotes, at-risk customers) is one click away.</p>
          </div>
        </div>
        <div class="tv-cta-row">
          <a class="btn btn-primary" href="https://twistorhq.github.io/lbt-os/app/tradeview">See your shop's real map</a>
          <p class="tv-note">The live Trade View, running on the platform.</p>
        </div>
      </div>
    </section>

    <section class="platform" id="platform">
      <div class="inner">
        <h2>One platform underneath it all: Twistor Core</h2>
        <p>
          Every Twistor product runs on the same production platform. Voice AI,
          business texting, agent orchestration, and your data, so each new
          product inherits the reliability of all the others.
        </p>
        <ul>
          <li>AI voice reception with human escalation</li>
          <li>Business SMS: reminders, confirmations, text-back</li>
          <li>Stateful agent workflows with audit trails</li>
          <li>Real integrations with your PMS, dispatch board, CRM</li>
          <li>Per-client data isolation and spend controls</li>
          <li>Monitored around the clock with automatic rollback</li>

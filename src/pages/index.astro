---
import '@fontsource/bricolage-grotesque/500.css';
import '@fontsource/bricolage-grotesque/700.css';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Demo slot convention (TW-1208 / TW-1212): Nia's per-product walkthrough
// films land in public/demos/ as <slug>.mp4 with a <slug>.jpg poster and an
// optional <slug>.vtt captions track. The build checks for the files, so a
// film drops in with no page rework: present means the slot renders the
// player, absent means it renders the still or panel fallback below.
const demoDir = fileURLToPath(new URL('../../public/demos/', import.meta.url));
const demoFile = (slug: string, ext: string) => existsSync(demoDir + slug + ext);

type Product = {
  slug: string;
  name: string;
  blurb: string;
  proof: string;
  still?: { src: string; alt: string };
  link?: { href: string; label: string; external?: boolean };
  status?: string;
};

const products: Product[] = [
  {
    slug: 'trades',
    name: 'Twistor Trades',
    blurb:
      'The front office for home service shops. Every call answered, every lead followed up, every job on one board, so a good shop never loses work to a ringing phone.',
    proof:
      'Live demo published, with pricing in plain sight: $299 a month for Starter, $499 a month for Pro.',
    still: {
      src: '/stills/front-office.webp',
      alt: 'A specialist on a headset, smiling mid-call.',
    },
    link: { href: base + '/trades/', label: 'See Twistor Trades' },
  },
  {
    slug: 'social',
    name: 'Twistor Social',
    blurb:
      'A groups-first meetup app built on verified identity and real accountability, made to get people off the couch and into the real world.',
    proof: 'Launched on the web on November 7, 2026.',
    still: {
      src: '/stills/establish.webp',
      alt: 'Colleagues celebrating together around a laptop.',
    },
    status: 'Temporarily offline while hosting is restored. It comes back here when it is live again.',
  },
  {
    slug: 'tori',
    name: 'Tori',
    blurb:
      'An AI front desk agent who works the phones and the inbox like a trusted hire. She answers, triages, books, and follows up, and she says plainly that she is an AI agent on every call.',
    proof:
      'Calling engine merged into the production codebase on November 1, 2026. Tailored Tori runs $49 to $99 a month by role.',
    still: {
      src: '/stills/enter.webp',
      alt: 'A colleague presenting to the team in a bright office.',
    },
    status: 'In production. Book a demo below to hear her work.',
  },
  {
    slug: 'clips',
    name: 'Twistor Clips',
    blurb:
      'Permission-first clipping as a service. Send us your long video and get back short clips, cut, captioned, and ready to post. We only clip content you own or are licensed to use.',
    proof: 'Private beta in first-user testing since October 31, 2026. $299 a month covers 20 clips.',
    status: 'Private beta. Wider opening follows the beta.',
  },
  {
    slug: '4szns',
    name: '4SZNS',
    blurb:
      'Youth sports analytics for schools, districts, and leagues. Tracked possessions, honest film, and numbers a coach can teach from, in every season.',
    proof:
      'Infrastructure phase complete, with the build pipeline green since November 11, 2026. Pricing is set at $599 per team per season.',
    still: {
      src: '/stills/season.webp',
      alt: 'A youth basketball team in a sideline huddle with its coaches.',
    },
    status: 'In build. Infrastructure first, the site follows.',
  },
  {
    slug: 'our-lgcy',
    name: 'Our LGCY',
    blurb:
      'A living family archive that turns records into a family tree. Every person documented, every fact cited, every story kept for the generations coming up behind us.',
    proof:
      'The reference corpus holds 107,723 Dawes Final Rolls records, indexed and verified, including 23,752 Freedmen records across five tribal nations.',
    link: {
      href: 'https://twistorhq.github.io/ourlgcy-demo/',
      label: 'Open the live demo',
      external: true,
    },
  },
  {
    slug: 'data',
    name: 'Twistor Data',
    blurb:
      'Data products and datasets with lineage you can audit. Pay per use, priced in plain sight, and built on a collection system that runs every day.',
    proof:
      'The bronze data layer passed 167,000 source files on November 19, 2026, and grows on a 15 minute collection cycle.',
    still: {
      src: '/stills/data.webp',
      alt: 'An analyst working at dual monitors with dashboards live.',
    },
    link: { href: base + '/products/data-analytics', label: 'See Twistor Data' },
  },
  {
    slug: 'cinematic',
    name: 'Twistor Cinematic',
    blurb:
      'Product films and cinematic web builds with a director\u2019s discipline, offered as software on Twistor Core and as done-for-you productions.',
    proof:
      'The demo films on this page are ours, produced end to end in-house. The first walkthrough film shipped on November 19, 2026.',
    still: {
      src: '/cinematic/media/contact-sheet.jpg',
      alt: 'A contact sheet of frames from a Twistor cinematic build.',
    },
    status: 'Working today. Book a demo below to start a production.',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/webp" href={base + '/logo-mark.webp'} />
    <meta property="og:image" content="https://twistor.co/logo-mark.webp" />
    <meta property="og:title" content="Twistor | Software that does the work" />
    <meta
      property="og:description"
      content="Twistor builds practical software: a front office for home service shops, sports analytics, a living family archive, data products, and product films. Every product on this page links to the real thing."
    />
    <meta property="og:url" content="https://twistor.co/" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Twistor | Software that does the work" />
    <meta
      name="twitter:description"
      content="Twistor builds practical software: a front office for home service shops, sports analytics, a living family archive, data products, and product films. Every product on this page links to the real thing."
    />
    <title>Twistor | Software that does the work</title>
    <meta
      name="description"
      content="Twistor builds practical software: a front office for home service shops, sports analytics, a living family archive, data products, and product films. Every product on this page links to the real thing."
    />
    <style>
      :root {
        --bg: #faf7f2;
        --surface: #ffffff;
        --ink: #1c1a17;
        --muted: #5f5a54;
        --accent: #ff5a1f;
        --accent-text: #b5430e;
        --line: #e5dfd5;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        color: var(--ink);
        background: var(--bg);
        line-height: 1.65;
        font-size: 1.0625rem;
      }
      img, video { max-width: 100%; }
      h1, h2, h3 { font-family: 'Bricolage Grotesque', system-ui, sans-serif; }
      a:focus-visible, button:focus-visible {
        outline: 3px solid var(--accent-text);
        outline-offset: 3px;
        border-radius: 4px;
      }
      .skip-link {
        position: absolute;
        left: 16px;
        top: -60px;
        background: var(--ink);
        color: var(--bg);
        padding: 10px 16px;
        border-radius: 8px;
        z-index: 10;
        transition: top 0.15s ease;
      }
      .skip-link:focus { top: 12px; }
      .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }

      header.site {
        position: sticky;
        top: 0;
        background: var(--bg);
        border-bottom: 1px solid var(--line);
        z-index: 5;
      }
      .site-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px 24px;
        flex-wrap: wrap;
        padding-top: 14px;
        padding-bottom: 14px;
      }
      .wordmark { font-weight: 700; font-size: 1.3rem; letter-spacing: -0.02em; margin: 0; font-family: 'Bricolage Grotesque', system-ui, sans-serif; }
      .wordmark span { color: var(--accent); }
      nav.main { display: flex; gap: 4px 22px; flex-wrap: wrap; align-items: center; }
      nav.main a { color: var(--ink); text-decoration: none; font-weight: 500; padding: 6px 2px; }
      nav.main a:hover { color: var(--accent-text); text-decoration: underline; text-underline-offset: 4px; }
      .btn {
        display: inline-block;
        background: var(--ink);
        color: var(--bg);
        padding: 12px 22px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        min-height: 44px;
      }
      .btn:hover { background: var(--accent-text); }

      .hero { padding: 72px 0 56px; }
      .hero h1 {
        font-size: clamp(2rem, 1.35rem + 3.2vw, 3.4rem);
        line-height: 1.08;
        letter-spacing: -0.02em;
        font-weight: 700;
        margin: 0 0 20px;
        max-width: 14em;
      }
      .hero h1 .accent-line { color: var(--accent-text); }
      .hero p { max-width: 62ch; margin: 0 0 16px; font-size: 1.125rem; }
      .hero .core-line { color: var(--muted); font-size: 1rem; }

      section.lineup { padding: 8px 0 24px; }
      section.lineup > h2 {
        font-size: clamp(1.6rem, 1.25rem + 1.6vw, 2.2rem);
        letter-spacing: -0.02em;
        margin: 0 0 8px;
      }
      section.lineup > p.intro { max-width: 62ch; margin: 0; color: var(--muted); }

      article.product {
        display: grid;
        grid-template-columns: 1.05fr 1fr;
        gap: 28px 48px;
        align-items: center;
        padding: 44px 0;
        border-top: 1px solid var(--line);
      }
      article.product.flip .demo { order: 2; }
      figure.demo { margin: 0; }
      .slot {
        aspect-ratio: 16 / 9;
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
        background: var(--surface);
      }
      .slot img, .slot video { width: 100%; height: 100%; object-fit: cover; display: block; }
      .slot .panel {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 6px;
        padding: 24px 28px;
        background: var(--ink);
        color: var(--bg);
      }
      .slot .panel .panel-name { font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-weight: 700; font-size: 1.5rem; letter-spacing: -0.02em; }
      .slot .panel .panel-note { color: #d8d2c9; font-size: 0.95rem; }
      figure.demo figcaption { color: var(--muted); font-size: 0.9rem; margin-top: 10px; }
      article.product h3 { font-size: 1.5rem; letter-spacing: -0.02em; margin: 0 0 10px; }
      article.product p { margin: 0 0 12px; max-width: 58ch; }
      article.product p.proof { color: var(--muted); font-size: 0.95rem; }
      article.product p.status { font-size: 0.95rem; font-weight: 600; }
      article.product p.status::before {
        content: '';
        display: inline-block;
        width: 9px;
        height: 9px;
        background: var(--accent);
        margin-right: 9px;
      }
      a.product-link { color: var(--accent-text); font-weight: 600; text-decoration: none; }
      a.product-link:hover { text-decoration: underline; text-underline-offset: 4px; }

      section.cta-band { border-top: 1px solid var(--line); padding: 56px 0 64px; }
      section.cta-band h2 { font-size: clamp(1.6rem, 1.25rem + 1.6vw, 2.2rem); letter-spacing: -0.02em; margin: 0 0 10px; }
      section.cta-band p { max-width: 58ch; margin: 0 0 22px; }

      footer.site { border-top: 1px solid var(--line); padding: 28px 0 40px; color: var(--muted); font-size: 0.95rem; }
      .footer-inner { display: flex; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap; }
      footer.site a { color: var(--ink); font-weight: 600; }
      footer.site p { margin: 0; }

      @media (max-width: 760px) {
        .wrap { padding: 0 20px; }
        .hero { padding: 44px 0 36px; }
        article.product { grid-template-columns: 1fr; gap: 20px; padding: 36px 0; }
        article.product.flip .demo { order: 0; }
        nav.main a { padding: 10px 2px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .skip-link { transition: none; }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#products">Skip to the products</a>
    <header class="site">
      <div class="wrap site-inner">
        <p class="wordmark">Twistor<span>.</span></p>
        <nav class="main" aria-label="Main">
          <a href="#products">Products</a>
          <a href={base + '/trades/'}>Trades</a>
          <a href={base + '/products/data-analytics'}>Data</a>
          <a href="https://twistorhq.github.io/ourlgcy-demo/">Our LGCY demo</a>
        </nav>
        <a class="btn" href="mailto:holla@twistor.co?subject=Demo%20request">Book a demo</a>
      </div>
    </header>
    <main>
      <section class="hero">
        <div class="wrap">
          <h1>Every call answered. Every season tracked. <span class="accent-line">Every record kept.</span></h1>
          <p>
            Twistor is a software company in Denver, Colorado. We build the front office for home
            service shops, analytics for school sports, a living archive for families, and data
            products with lineage you can audit. Every product below is real: watch its film, then
            follow the link to the thing itself.
          </p>
          <p class="core-line">
            Everything runs on Twistor Core, our own platform for agents, billing, data, and delivery.
          </p>
        </div>
      </section>
      <section class="lineup" id="products" aria-label="The Twistor product lineup">
        <div class="wrap">
          <h2>The Lineup</h2>
          <p class="intro">
            Eight products, one company. Where a product is live, the link takes you to it. Where it
            is not, the page says so plainly and tells you where it stands.
          </p>
          {
            products.map((p, i) => (
              <article class:list={['product', { flip: i % 2 === 1 }]} id={'product-' + p.slug}>
                <figure class="demo">
                  <div class="slot">
                    {demoFile(p.slug, '.mp4') ? (
                      <video
                        controls
                        preload="none"
                        poster={demoFile(p.slug, '.jpg') ? base + '/demos/' + p.slug + '.jpg' : undefined}
                        aria-label={p.name + ' demo film'}
                      >
                        <source src={base + '/demos/' + p.slug + '.mp4'} type="video/mp4" />
                        {demoFile(p.slug, '.vtt') && (
                          <track kind="captions" src={base + '/demos/' + p.slug + '.vtt'} srclang="en" label="English" />
                        )}
                      </video>
                    ) : p.still ? (
                      <img src={base + p.still.src} alt={p.still.alt} loading="lazy" />
                    ) : (
                      <div class="panel">
                        <span class="panel-name">{p.name}</span>
                        <span class="panel-note">The demo film for this product is in production.</span>
                      </div>
                    )}
                  </div>
                  <figcaption>
                    {demoFile(p.slug, '.mp4')
                      ? 'Watch: the ' + p.name + ' demo film.'
                      : 'Demo film in production. It lands in this slot the day it is finished.'}
                  </figcaption>
                </figure>
                <div class="product-text">
                  <h3>{p.name}</h3>
                  <p>{p.blurb}</p>
                  <p class="proof">{p.proof}</p>
                  {p.link ? (
                    <p>
                      <a
                        class="product-link"
                        href={p.link.href}
                        {...(p.link.external ? { target: '_blank', rel: 'noopener' } : {})}
                      >
                        {p.link.label} →
                      </a>
                    </p>
                  ) : (
                    <p class="status">{p.status}</p>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </section>
      <section class="cta-band" aria-label="Work with us">
        <div class="wrap">
          <h2>Work with us</h2>
          <p>Book a demo: thirty minutes, your numbers, no pitch deck theater.</p>
          <a class="btn" href="mailto:holla@twistor.co?subject=Demo%20request">Book a demo</a>
        </div>
      </section>
    </main>
    <footer class="site">
      <div class="wrap footer-inner">
        <p><a href={base + '/credits/'}>Photo Credits</a></p>
        <p>Twistor Holdings LLC, Denver, Colorado.</p>
        <p>Prepared by Twistor Holdings LLC.</p>
      </div>
    </footer>
  </body>
</html>

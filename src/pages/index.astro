---
import '@fontsource/bricolage-grotesque/500.css';
import '@fontsource/bricolage-grotesque/700.css';

const featured = {
  slug: 'trades-front-office',
  name: 'Trades AI Front Office',
  tagline: 'Every call answered. Every urgent job triaged.',
  blurb:
    'For HVAC, plumbing, roofing, and electrical shops: AI reception that answers every call, triages urgency, and posts jobs straight to your dispatch board. Built for the trades first, because missed calls are missed revenue.',
};
const products = [
  {
    slug: 'dental-front-office',
    name: 'Dental AI Front Office',
    tagline: 'Never lose a patient to voicemail again.',
    blurb:
      'AI answers every call, confirms appointments, texts back missed calls in under a minute, and books directly inside your practice management software, with a monthly report showing recovered revenue.',
  },
  {
    slug: 'dispatch-os',
    name: 'Dispatch OS',
    tagline: 'One board that runs your phones and your schedule.',
    blurb:
      'Jobs arrive by phone, email, or web. AI answers, triages, schedules, and confirms, while you watch a single dispatch board.',
  },
  {
    slug: 'compliance-agent',
    name: 'Compliance Evidence Agent',
    tagline: 'Your audit evidence, collected continuously.',
    blurb:
      'An agent living in your repos and cloud accounts, continuously collecting SOC 2 and HIPAA evidence and opening PRs when something drifts.',
  },
  {
    slug: 'data-analytics',
    name: 'Managed Data + Analytics',
    tagline: 'Your data team, done for you.',
    blurb:
      'Pipelines from your SaaS tools into a clean warehouse, dashboards you actually read, and a monthly KPI memo in plain English.',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/webp" href="/logo-mark.webp" />
    <meta property="og:image" content="https://twistor.co/logo-mark.webp" />
    <title>Twistor | The company that does it all</title>
    <meta
      name="description"
      content="Twistor builds AI systems that answer your phones, recover your revenue, and run your operations. One platform, every product."
    />
    <style>
      :root {
        --bg: #0a0a0f;
        --surface: #13131b;
        --ink: #f5f3ff;
        --muted: #a7a3bd;
        --accent: #8b5cf6;
        --line: #26262f;
      }
      * { box-sizing: border-box; }
      body {
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        margin: 0;
        color: var(--ink);
        background: var(--bg);
        line-height: 1.6;
        font-size: 1rem;
      }
      h1, h2, h3 { font-family: 'Bricolage Grotesque', system-ui, sans-serif; }
      header, main, footer { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 24px;
        padding-bottom: 24px;
      }
      .logo { font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-weight: 700; font-size: 1.25rem; letter-spacing: -0.02em; }
      .logo span { color: var(--accent); }
      nav a { margin-left: 20px; color: var(--muted); text-decoration: none; font-weight: 500; }
      nav a:hover { color: var(--ink); }
      .hero { padding: 88px 0 64px; }
      .hero h1 { font-size: 3rem; line-height: 1.08; letter-spacing: -0.03em; margin: 0 0 16px; font-weight: 700; }
      .hero h1 span { color: var(--accent); }
      .hero p { font-size: 1.2rem; color: var(--muted); max-width: 640px; }
      .cta-row { margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap; }
      .btn { display: inline-block; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 1rem; }
      .btn-primary { background: var(--accent); color: #0a0a0f; }
      .btn-ghost { border: 1px solid var(--line); color: var(--ink); }
      .section-title { font-size: 2rem; letter-spacing: -0.02em; margin: 0 0 8px; font-weight: 700; }
      .section-sub { color: var(--muted); margin: 0 0 32px; max-width: 640px; font-size: 1rem; }
      .featured {
        border: 1px solid var(--line);
        
        border-radius: 12px;
        padding: 32px;
        background: var(--surface);
        margin-bottom: 20px;
      }
      .featured .kicker { color: var(--accent); font-weight: 700; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 8px; }
      .featured h3 { margin: 0 0 4px; font-size: 1.6rem; font-weight: 700; }
      .featured .tagline { color: var(--accent); font-weight: 600; font-size: 1rem; margin: 0 0 12px; }
      .featured p { color: var(--muted); font-size: 1rem; margin: 0 0 16px; max-width: 720px; }
      .featured a { color: var(--accent); font-weight: 600; text-decoration: none; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; padding: 0 0 72px; }
      .card { border: 1px solid var(--line); border-radius: 12px; padding: 24px; background: var(--surface); }
      .card h3 { margin: 0 0 4px; font-size: 1.15rem; font-weight: 700; }
      .card .tagline { color: var(--accent); font-weight: 600; font-size: 1rem; margin: 0 0 8px; }
      .card p { color: var(--muted); font-size: 1rem; margin: 0 0 12px; }
      .card a { color: var(--accent); font-weight: 600; text-decoration: none; }
      .platform { background: var(--surface); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 64px 0; margin-top: 24px; }
      .platform .inner { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
      .platform h2 { font-size: 2rem; margin: 0 0 12px; letter-spacing: -0.02em; font-weight: 700; }
      .platform p { color: var(--muted); max-width: 680px; font-size: 1rem; }
      .platform ul { color: var(--muted); columns: 2; max-width: 680px; padding-left: 20px; font-size: 1rem; }
      .platform li { margin-bottom: 8px; }
      .platform li::marker { color: var(--accent); }
      #contact { padding: 64px 0; }
      .placeholder { border: 2px dashed var(--line); border-radius: 12px; padding: 24px; color: var(--muted); margin: 24px 0; font-size: 1rem; }
      .placeholder strong { color: var(--ink); }
      footer { padding: 40px 24px; color: var(--muted); font-size: 0.9rem; border-top: 1px solid var(--line); }
      @media (max-width: 640px) {
        .hero h1 { font-size: 2.2rem; }
        .platform ul { columns: 1; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="logo">Twistor<span>.</span></div>
      <nav>
        <a href="#products">Products</a>
        <a href="#platform">Platform</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>The company that <span>does it all.</span></h1>
        <p>
          Twistor builds AI systems that answer your phones, recover your
          revenue, and run your operations. One platform, every product.
          Designed, deployed, and supported by the team that builds it.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#contact">Book a demo</a>
          <a class="btn btn-ghost" href="#products">See the products</a>
        </div>
      </section>

      <section id="products">
        <h2 class="section-title">Products</h2>
        <p class="section-sub">
          Five products, one platform. We started with the trades, where a
          missed call is a missed job.
        </p>
        <div class="featured">
          <p class="kicker">Our wedge</p>
          <h3>{featured.name}</h3>
          <p class="tagline">{featured.tagline}</p>
          <p>{featured.blurb}</p>
          <a href={`/products/${featured.slug}/`}>Learn more →</a>
        </div>
        <div class="grid">
          {products.map((p) => (
            <div class="card">
              <h3>{p.name}</h3>
              <p class="tagline">{p.tagline}</p>
              <p>{p.blurb}</p>
              <a href={`/products/${p.slug}/`}>Learn more →</a>
            </div>
          ))}
        </div>
      </section>
    </main>

    <section class="platform" id="platform">
      <div class="inner">
        <h2>One platform underneath it all: Twistor Core</h2>
        <p>
          Every Twistor product runs on the same production platform. Voice AI,
          business texting, agent orchestration, and your data, so each new
          product inherits the reliability of all the others.
        </p>
        <ul>
          <li>AI voice reception with human escalation</li>
          <li>Business SMS: reminders, confirmations, text-back</li>
          <li>Stateful agent workflows with audit trails</li>
          <li>Real integrations with your PMS, dispatch board, CRM</li>
          <li>Per-client data isolation and spend controls</li>
          <li>Monitored around the clock with automatic rollback</li>
        </ul>
      </div>
    </section>

    <main>
      <section id="contact">
        <h2 class="section-title">Talk to us</h2>
        <div class="placeholder">
          <strong>[PLACEHOLDER: contact form / booking link]</strong><br />
          Contact form and scheduling link go here once the domain and
          booking tool are configured. No inquiries are collected yet.
        </div>
        <div class="placeholder">
          <strong>[PLACEHOLDER: proof section]</strong><br />
          Case studies, recovered-revenue numbers, and client quotes will
          appear here only after real pilots produce real results.
          Nothing here is invented.
        </div>
      </section>
    </main>

    <footer>
      © 2026 Twistor LLC · Denver, Colorado · Built on Twistor Core
    </footer>
  </body>
</html>

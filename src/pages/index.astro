    <script is:inline src={base + "/vendor/leaflet/leaflet.js"}></script>
    <script is:inline src={base + "/scripts/tv-overlays.js"}></script>
    <script is:inline>
      // Mini Trade View teaser: real public overlays when available (TW-446),
      // clearly-labeled sample pins otherwise (TW-448). Deliberately a taste
      // of the real /app/tradeview: pins + toggles + legend, no dossiers,
      // no data connection. One layer failing never breaks the map.
      (function () {
        var mapEl = document.getElementById('tv-map');
        var fallbackEl = document.getElementById('tv-map-fallback');
        function showFallback() {
          if (mapEl) mapEl.style.display = 'none';
          if (fallbackEl) fallbackEl.style.display = 'block';
        }
        if (!mapEl || typeof window.L === 'undefined' || !window.TwistorTvOverlays) {
          showFallback();
          return;
        }
        var map = window.L.map('tv-map', { scrollWheelZoom: false }).setView([39.73, -104.96], 10);
        window.L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        var tagEl = document.getElementById('tv-data-tag');
        var togglesEl = document.getElementById('tv-toggles');
        var legendEl = document.getElementById('tv-legend');
        var attribEl = document.getElementById('tv-attrib');
        var panelSample = document.getElementById('tv-panel-sample');
        var panelLive = document.getElementById('tv-panel-live');
        var liveRows = document.getElementById('tv-live-rows');
        var layerGroups = {};

        function esc(s) {
          return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function renderPins(layer) {
          var group = window.L.layerGroup();
          layer.pins.forEach(function (p) {
            var title = (p.isSample ? 'Sample: ' : '') + p.label;
            var icon = window.L.divIcon({
              className: 'tv-pin-wrap',
              html: '<span class="tv-pin" style="--tv-pin-bg:' + esc(layer.color) + ';--tv-pin-fg:#fff" title="' + esc(title) + '">' + esc(p.label) + '</span>',
              iconSize: null
            });
            window.L.marker([p.lat, p.lng], { icon: icon, keyboard: false }).addTo(group);
          });
          return group;
        }

        function setAriaLabel(data) {
          var parts = data.layers.filter(function (l) { return l.pins.length; }).map(function (l) {
            return l.pins.length + ' ' + l.label.toLowerCase() + (l.isSample ? ' (sample)' : '');
          });
          var desc = parts.length ? parts.join(', ') : 'no pins';
          mapEl.setAttribute('aria-label',
            (data.anyLive ? 'Live public-data map' : 'Sample map') +
            ' of the Denver metro area: ' + desc + '.');
        }

        function renderChrome(data) {
          var anyLive = data.anyLive;
          var headingEl = document.getElementById('tv-heading');
          var ledeEl = document.getElementById('tv-lede');
          var statusEl = document.getElementById('tv-status');
          // Headline and lede are honest in both states (never claim real
          // signals while showing sample pins).
          if (headingEl) {
            headingEl.textContent = anyLive
              ? 'Trade View: real signals, on a live map'
              : 'Trade View: the shape of your leak map';
          }
          if (ledeEl) {
            ledeEl.textContent = anyLive
              ? 'Live public signals from the Denver metro: building permits and weather alerts, the same radar that watches your shop every morning. This is public data; your shop\u2019s private leak map is one click away.'
              : 'Sample pins showing the shape of what Trade View watches for your shop, every morning. Live public signals connect here soon: your shop\u2019s private leak map is one click away.';
          }
          if (statusEl) {
            var counts = data.layers.map(function (l) {
              return l.pins.length + ' ' + l.label.toLowerCase() + (l.isSample ? ' (sample)' : '');
            }).join(', ');
            statusEl.textContent = anyLive
              ? 'Live public data loaded: ' + counts + '.'
              : 'Showing sample map data.';
          }
          if (tagEl) {
            if (anyLive) {
              tagEl.className = 'live-tag';
              tagEl.textContent = 'Live public data: Denver metro';
            } else {
              tagEl.className = 'sample-tag';
              tagEl.textContent = 'Sample data: fictional shops';
            }
          }
          var showLive = anyLive;
          if (panelSample) panelSample.hidden = showLive;
          if (panelLive) panelLive.hidden = !showLive;
          if (showLive && liveRows) {
            var html = '';
            data.layers.forEach(function (l) {
              html += '<div class="tv-row"><span class="tv-label">' + esc(l.label) +
                '<span class="tv-asof">' + (l.isSample ? 'sample' : 'as of ' + esc(l.asOfLabel)) + '</span></span>' +
                '<span class="tv-val">' + l.pins.length + ' in view</span></div>';
            });
            liveRows.innerHTML = html;
          }
          if (togglesEl) togglesEl.hidden = false;
          if (legendEl) {
            legendEl.hidden = false;
            var lh = '';
            data.layers.forEach(function (l) {
              lh += '<span><span class="tv-dot" style="background:' + esc(l.color) + '"></span>' + esc(l.label) + '</span>';
            });
            legendEl.innerHTML = lh;
          }
          if (attribEl) {
            var live = data.layers.filter(function (l) { return l.live && !l.isSample; });
            if (live.length) {
              attribEl.hidden = false;
              var ah = 'Sources: ';
              ah += live.map(function (l) {
                var name = esc(l.attribution);
                var bit = l.sourceUrl ? '<a href="' + esc(l.sourceUrl) + '" target="_blank" rel="noopener">' + name + '</a>' : name;
                return bit + ' (as of ' + esc(l.asOfLabel) + ')';
              }).join(' · ');
              attribEl.innerHTML = ah;
            } else {
              attribEl.hidden = true;
            }
          }
          data.layers.forEach(function (l) {
            var lab = document.getElementById('tv-toggle-' + l.id + '-label');
            if (lab) lab.textContent = l.label;
          });
        }

        function wireToggles() {
          ['permits', 'weather'].forEach(function (id) {
            var box = document.getElementById('tv-toggle-' + id);
            if (!box) return;
            box.addEventListener('change', function () {
              var group = layerGroups[id];
              if (!group) return;
              if (box.checked) { group.addTo(map); } else { map.removeLayer(group); }
            });
          });
        }

        var b = map.getBounds();
        var bounds = { north: b.getNorth(), south: b.getSouth(), east: b.getEast(), west: b.getWest() };
        window.TwistorTvOverlays.load(bounds).then(function (data) {
          data.layers.forEach(function (layer) {
            var group = renderPins(layer);
            layerGroups[layer.id] = group;
            group.addTo(map);
          });
          renderChrome(data);
          wireToggles();
          setAriaLabel(data);
        }).catch(function () {
          // Loader never rejects by contract; this is a last-resort guard.
          showFallback();
        });
      })();
    </script>
    <script>
      (function () {
        var callsEl = document.getElementById('leak-calls');
        var valueEl = document.getElementById('leak-value');
        var rateEl = document.getElementById('leak-rate');
        var callsOut = document.getElementById('leak-calls-out');
        var valueOut = document.getElementById('leak-value-out');
        var rateOut = document.getElementById('leak-rate-out');
        var monthEl = document.getElementById('leak-month');
        var yearEl = document.getElementById('leak-year');
        var liveEl = document.getElementById('leak-live');
        var fmt = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var raf = null;
        var liveTimer = null;
        var displayed = { month: 0, year: 0 };

        function targets() {
          var calls = Number(callsEl.value);
          var value = Number(valueEl.value);
          var rate = Number(rateEl.value) / 100;
          var month = calls * 4.33 * value * rate;
          return { month: month, year: month * 12 };
        }

        function render(t) {
          monthEl.textContent = fmt.format(Math.round(t.month));
          yearEl.textContent = fmt.format(Math.round(t.year));
        }

        function announce(t) {
          clearTimeout(liveTimer);
          liveTimer = setTimeout(function () {
            liveEl.textContent = 'Estimated revenue leaking: ' +
              fmt.format(Math.round(t.month)) + ' per month, ' +
              fmt.format(Math.round(t.year)) + ' per year.';
          }, 100);
        }

        function animate(to) {
          if (reduceMotion) { displayed = to; render(to); announce(to); return; }
          if (raf) cancelAnimationFrame(raf);
          var fromMonth = displayed.month;
          var fromYear = displayed.year;
          var start = null;
          var dur = 450;
          function step(ts) {
            if (!start) start = ts;
            var p = Math.min((ts - start) / dur, 1);
            var e = 1 - Math.pow(1 - p, 3);
            displayed = {
              month: fromMonth + (to.month - fromMonth) * e,
              year: fromYear + (to.year - fromYear) * e
            };
            render(displayed);
            if (p < 1) { raf = requestAnimationFrame(step); }
            else { announce(to); }
          }
          raf = requestAnimationFrame(step);
        }

        function update() {
          callsOut.textContent = callsEl.value;
          valueOut.textContent = fmt.format(Number(valueEl.value));
          rateOut.textContent = rateEl.value + '%';
          animate(targets());
        }

        [callsEl, valueEl, rateEl].forEach(function (el) {
          el.addEventListener('input', update);
        });
        update();
      })();
    </script>
  </body>
</html>
